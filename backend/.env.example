# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── PostgreSQL (direct connection for pg pool) ────────────────────────────────
# Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── Token / credential encryption ────────────────────────────────────────────
# 32-byte key, base64 or hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_KEY_BASE64_OR_HEX

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Web OAuth callback URL — must match Authorized Redirect URIs in Google Console
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/auth/google/callback
# Deep link the callback redirects to after successful web OAuth
GOOGLE_APP_DEEP_LINK=beforeitbills://oauth-success

# ── CORS (optional, web only) ─────────────────────────────────────────────────
# Comma-separated. Mobile requests have no Origin header and are always allowed.
CORS_ORIGINS=https://yourdomain.com

# ── LLM (optional — required for POST /parse-subscription) ───────────────────
# Used for natural language subscription parsing (gpt-4.1-mini recommended)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# ── Queue / async scan (Tier 11 — optional) ───────────────────────────────────
# Set to "true" to enable BullMQ background scan jobs
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379
