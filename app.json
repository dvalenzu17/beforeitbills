{
  "expo": {
    "name": "Sublytics",
    "slug": "sublytics",
    "scheme": "sublytics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/profile.png",
    "splash": {
      "image": "./assets/profile.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dvalenzu17.sublytics",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dvalenzu17.sublytics",
      "adaptiveIcon": {
        "foregroundImage": "./assets/profile.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/profile.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "47e62a9c-3e47-4af7-90f3-1b5779fcc586"
      }
    }
  }
}
